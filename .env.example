# Copy to .env locally; never commit the real .env file.
LLM_PROVIDER=openai
LLM_API_KEY=replace-with-your-local-secret
LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://api.deepseek.com/v1

# Tier-3 request resilience.
PHOENIX_LLM_TIMEOUT_MS=30000
PHOENIX_LLM_MAX_RETRIES=2
PHOENIX_LLM_RETRY_BASE_MS=250
PHOENIX_LLM_CIRCUIT_FAILURE_THRESHOLD=5
PHOENIX_LLM_CIRCUIT_RESET_MS=30000

# Enable only for trusted local development targets.
# PHOENIX_ALLOW_PRIVATE_NETWORK=true
